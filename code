string getCurrentDateTime() {
    time_t now = time(nullptr);
    tm* localTime = localtime(&now);

    char buffer[30];
    strftime(buffer, sizeof(buffer), "%Y-%m-%d %H:%M:%S", localTime);

    return string(buffer);
}

string getNumericPassword(string message) {
    string pass;
    while (true) {
        cout << message;
        cin >> pass;

        bool allDigits = true;
        for (int i = 0; i < (int)pass.length(); i++) {
            if (!isdigit(pass[i])) {
                allDigits = false;
                break;
            }
        }

        if (pass.empty() || !allDigits) {
            cout << color::red << "Password must contain numbers only! Try again." << color::reset << endl;
        }
        else {
            return pass;
        }
    }
}

string getAlphabetUsername(string message) {
    string uname;
    while (true) {
        cout << message;
