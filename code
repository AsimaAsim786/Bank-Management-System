int main() {
    sys::EnableVirtualTerminalProcessing();
    showWelcome();

    Bank bank;
    bank.loadAccounts();
    bank.loadCustomers();
    bank.loadTransactions();

    int choice;
    do {
        sys::clearscreen();
        printCentered("=== BANK MENU ===", style::bold + color::cyan);
        cout << endl;
        cout << "1. Register New Customer" << endl;
        cout << "2. Login" << endl;
        cout << "3. Exit" << endl;
        choice = sys::getint("Enter choice: ");

        if (choice == 1) {
            string customerid, username, password, name;

            customerid = getNumericId("Enter Customer ID (numbers only): ");
            username = getAlphabetUsername("Enter Username (letters only): ");
            password = getNumericPassword("Enter Password (numbers only): ");
            cout << "Enter Name: ";
            cin >> name;

            Customer* newCustomer = new Customer(customerid, username, password, name);
            bank.addCustomer(newCustomer);

            showSuccess("Registration successful!");
        }
        else if (choice == 2) {
            string username, password;
            username = getAlphabetUsername("Enter Username: ");
            password = getNumericPassword("Enter Password: ");

            Customer* loggedInCustomer = bank.login(username, password);

            if (loggedInCustomer == nullptr) {
                showError("Login failed! Incorrect username or password.");
            }
            else {
                showSuccess("Login successful! Welcome " + loggedInCustomer->getName());

                int loginMenuChoice;
                do {
                    cout << "\n1. Create New Account" << endl;
                    cout << "2. View / Use My Accounts" << endl;
                    cout << "3. Logout" << endl;
                    loginMenuChoice = sys::getint("Enter choice: ");

                    if (loginMenuChoice == 1) {
                        int typeChoice;
                        cout << "1. Saving Account" << endl;
                        cout << "2. Transaction Account" << endl;
                        typeChoice = sys::getint("Select account type: ");

                        string accountnum;
                        double openingBalance;
                        accountnum = getNumericId("Enter new Account Number (numbers only): ");
                        openingBalance = sys::getfloat("Enter opening balance: ");

                        string today = getCurrentDateTime();
                        Account* newAcc = nullptr;

                        if (typeChoice == 1) {
                            double minBalance;
                            minBalance = sys::getfloat("Enter minimum balance requirement: ");
                            newAcc = new SavingAccount(accountnum, loggedInCustomer->getCustomerId(),
                                                        openingBalance, today, minBalance);
                        }
                        else if (typeChoice == 2) {
                            newAcc = new TransactionAccount(accountnum, loggedInCustomer->getCustomerId(),
                                                             openingBalance, today, &bank);
                        }

                        if (newAcc != nullptr) {
                            loggedInCustomer->addAccount(newAcc);
                            bank.registerNewAccount(newAcc);
                            showSuccess("Account created successfully!");
                        }
                        else {
                            showError("Invalid account type!");
                        }
                    }
                    else if (loginMenuChoice == 2) {

                vector<Account*> custAccounts = loggedInCustomer->getAccounts();

                if (custAccounts.size() == 0) {
                    showInfo("No accounts found for this customer!");
                }
                else {
                    cout << "Your Accounts:" << endl;
                    for (int i = 0; i < custAccounts.size(); i++) {
                        cout << i + 1 << ". Account Number: " << custAccounts[i]->getaccountnum()
                             << " | Balance: " << custAccounts[i]->getcurrentbalance() << endl;
                    }

                    int accChoice;
                    accChoice = sys::getint("Select account (number): ");

                    Account* selectedAccount = custAccounts[accChoice - 1];

                    int accMenuChoice;
                    do {
                        cout << "\n1. Deposit" << endl;
                        cout << "2. Withdraw" << endl;
                        cout << "3. Check Balance" << endl;
                        cout << "4. View Transaction History" << endl;
                        cout << "5. Transfer" << endl;
                        cout << "6. Back to Main Menu" << endl;
                        accMenuChoice = sys::getint("Enter choice: ");

                        if (accMenuChoice == 1) {
                            double amount;
                            amount = sys::getfloat("Enter amount to deposit: ");
                            if (selectedAccount->deposit(amount)) {
                                showSuccess("Deposit successful!");
                            } else {
                                showError("Deposit failed!");
                            }
                        }
                        else if (accMenuChoice == 2) {
                            double amount;
                            amount = sys::getfloat("Enter amount to withdraw: ");
                            if (selectedAccount->withdraw(amount)) {
                                showSuccess("Withdrawal successful!");
                            } else {
                                showError("Withdrawal failed!");
                            }}
                        else if (accMenuChoice == 3) {
                            cout << style::bold << color::cyan
                                 << "Current Balance: " << selectedAccount->getcurrentbalance()
                                 << color::reset << endl;
                            cout << style::bold << color::cyan << "Press any key to continue..." << color::reset;
                            sys::pause();
                        }
                        else if (accMenuChoice == 4) {
                            vector<Transaction> history = selectedAccount->getTransactions();
                            cout << style::bold << color::cyan << "--- Transaction History ---" << color::reset << endl;
                            for (int i = 0; i < history.size(); i++) {
                                cout << history[i].getdatetime() << " | "
                                     << history[i].gettype() << " | "
                                     << history[i].getamount() << endl;
                            }
                            cout << style::bold << color::cyan << "Press any key to continue..." << color::reset;
                            sys::pause();
                        }
                        else if (accMenuChoice == 5) {
                            TransactionAccount* transAcc = dynamic_cast<TransactionAccount*>(selectedAccount);
                            if (transAcc == nullptr) {
                                showError("This account type does not support transfers!");
                            }
                            else {
                                double amount;
                                string destAccNum;
                                amount = sys::getfloat("Enter amount to transfer: ");
                                destAccNum = getNumericId("Enter destination account number (numbers only): ");
                                if (transAcc->transfer(amount, destAccNum)) {
                                    showSuccess("Transfer successful!");
                                } else {
                                    showError("Transfer failed!");
                                }
                            }
                        }

                    } while (accMenuChoice != 6);
                }
                    }
                    else if (loginMenuChoice == 3) {
                        showSuccess("Logout successful!");
                    }

                } while (loginMenuChoice != 3);
            }
        }
        else if (choice == 3) {
            bank.saveAccounts();
            bank.saveCustomers();
            bank.saveTransactions();
            showSuccess("Data saved. Exiting...");
        }
        else {
            showError("Invalid choice!");
        }

    } while (choice != 3);

    return 0;
}