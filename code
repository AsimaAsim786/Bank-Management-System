class Transaction {
private:
    string accountnum;
    string datetime;
    double amount;
    string type;
    string sender;
    string receiver;
public:
    Transaction(string accountnum, string datetime, double amount,
                string type, string sender, string receiver)
    {
        this->accountnum = accountnum;
        this->datetime = datetime;
        this->amount = amount;
        this->type = type;
        this->sender = sender;
        this->receiver = receiver;
    }
    string getaccountnum() { return accountnum; }
    string getdatetime() { return datetime; }
    double getamount() { return amount; }
    string gettype() { return type; }
    string getsender() { return sender; }
    string getreceiver() { return receiver; }
};

class Account {
protected:
    string accountnum;
    string customerid;
    double currentbalance;
    string openingdate;
    vector<Transaction> transactions;
public:
    Account(string accountnum, string customerid, double currentbalance, string openingdate) {
        this->accountnum = accountnum;
        this->customerid = customerid;
        this->currentbalance = currentbalance;
        this->openingdate = openingdate;
    }

    string getaccountnum() { return accountnum; }
    string getcustomerid() { return customerid; }
    double getcurrentbalance() { return currentbalance; }
    string getopeningdate() { return openingdate; }

    void addTransaction(Transaction transaction) {
        transactions.push_back(transaction);
    }

    vector<Transaction> getTransactions() {
        return transactions;
    }

    virtual bool deposit(double amount) {
        if (amount < 0) {
            return false;
        }
        currentbalance = currentbalance + amount;

        Transaction transaction(
            getaccountnum(),
            getCurrentDateTime(),
            amount,
            "deposit",
            "",
            ""
        );
        addTransaction(transaction);

        return true;
    }

    virtual bool withdraw(double amount) {
        if (amount < 0 || amount > currentbalance) {
            return false;
        }
        currentbalance = currentbalance - amount;

        Transaction transaction(
            getaccountnum(),
            getCurrentDateTime(),
            amount,
            "withdraw",
            "",
            ""
        );
        addTransaction(transaction);

        return true;
    }

    virtual ~Account() {}
};

class SavingAccount : public Account {
private:
    double minimumbalance;
public:
    SavingAccount(string accountnum, string customerid, double currentbalance,
                  string openingdate, double minimumbalance)
        : Account(accountnum, customerid, currentbalance, openingdate)
    {
        this->minimumbalance = minimumbalance;
    }

    double getminimumbalance() { return minimumbalance; }

    bool withdraw(double amount) override {
        if (amount < 0 || currentbalance - amount < minimumbalance) {
            return false;
        }
        currentbalance = currentbalance - amount;

        Transaction transaction(
            getaccountnum(),
            getCurrentDateTime(),
            amount,
            "withdraw",
            "",
            ""
        );
        addTransaction(transaction);

        return true;
    }
};

class Bank;

class TransactionAccount : public Account {
private:
    Bank* bank;

public:
    TransactionAccount(string accountnum, string customerid,
                       double currentbalance, string openingdate,
                       Bank* bank)
        : Account(accountnum, customerid, currentbalance, openingdate)
    {
        this->bank = bank;
    }

    bool transfer(double amount, string destinationAccountNumber);
};

class Customer {
private:
    string customerid;
    string username;
    string password;
    string name;
    vector<Account*> accounts;

public:
    Customer(string customerid, string username, string password, string name) {
        this->customerid = customerid;
        this->username = username;
        this->password = password;
        this->name = name;
    }

    string getCustomerId() { return customerid; }
    string getUsername() { return username; }
    string getName() { return name; }
    vector<Account*> getAccounts() { return accounts; }

    bool addAccount(Account* account) {
        accounts.push_back(account);
        return true;
    }

    bool checkPassword(string inputUsername, string inputPassword) {
        return (username == inputUsername && password == inputPassword);
    }

    void saveToFile(ofstream& outFile) {
        outFile << customerid << "|" << username << "|" << password << "|" << name << "\n";
    }
};

class Bank {
private:
    vector<Customer*> customers;
    vector<Account*> allAccounts;

public:
    void addCustomer(Customer* customer) {
        customers.push_back(customer);
        vector<Account*> custAccounts = customer->getAccounts();
        for (int i = 0; i < custAccounts.size(); i++) {
            allAccounts.push_back(custAccounts[i]);
        }
    }

    Account* findAccount(string accountnum) {
        for (int i = 0; i < allAccounts.size(); i++) {
            if (allAccounts[i]->getaccountnum() == accountnum) {
                return allAccounts[i];
            }
        }
        return nullptr;
    }

    void registerNewAccount(Account* account) {
        allAccounts.push_back(account);
    }

    Customer* login(string username, string password) {
        for (int i = 0; i < customers.size(); i++) {
            if (customers[i]->checkPassword(username, password)) {
                return customers[i];
            }
        }
        return nullptr;
    }

    void saveAccounts() {
        ofstream outFile("accounts.txt");
        for (int i = 0; i < allAccounts.size(); i++) {
            outFile << allAccounts[i]->getaccountnum() << "|"
                    << allAccounts[i]->getcustomerid() << "|"
                    << allAccounts[i]->getcurrentbalance() << "|"
                    << allAccounts[i]->getopeningdate() << "\n";
        }
        outFile.close();
    }

    void saveCustomers() {
        ofstream outFile("customers.txt");
        for (int i = 0; i < customers.size(); i++) {
            customers[i]->saveToFile(outFile);
        }
        outFile.close();
    }

    void saveTransactions() {
        ofstream outFile("transactions.txt", ios::app);
        for (int i = 0; i < allAccounts.size(); i++) {
            vector<Transaction> accountTransactions = allAccounts[i]->getTransactions();
            for (int j = 0; j < accountTransactions.size(); j++) {
                outFile << accountTransactions[j].getaccountnum() << "|"
                        << accountTransactions[j].getdatetime() << "|"
                        << accountTransactions[j].getamount() << "|"
                        << accountTransactions[j].gettype() << "|"
                        << accountTransactions[j].getsender() << "|"
                        << accountTransactions[j].getreceiver() << endl;
            }
        }
        outFile.close();
    }

    void loadAccounts() {
        ifstream inFile("accounts.txt");
        string line;

        while (getline(inFile, line)) {
            stringstream ss(line);
            string accountnum, customerid, balanceStr, openingdate;

            getline(ss, accountnum, '|');
            getline(ss, customerid, '|');
            getline(ss, balanceStr, '|');
            getline(ss, openingdate, '|');

            double balance = stod(balanceStr);

            Account* account = new Account(accountnum, customerid, balance, openingdate);
            allAccounts.push_back(account);
        }
        inFile.close();
    }

    void loadCustomers() {
        ifstream inFile("customers.txt");
        string line;

        while (getline(inFile, line)) {
            stringstream ss(line);
            string customerid, username, password, name;

            getline(ss, customerid, '|');
            getline(ss, username, '|');
            getline(ss, password, '|');
            getline(ss, name, '|');

            Customer* customer = new Customer(customerid, username, password, name);
            customers.push_back(customer);
        }
        inFile.close();
    }

    void loadTransactions() {
        ifstream inFile("transactions.txt");
        string line;

        while (getline(inFile, line)) {
            stringstream ss(line);

            string accountnum, datetime, amountStr, type, sender, receiver;

            getline(ss, accountnum, '|');
            getline(ss, datetime, '|');
            getline(ss, amountStr, '|');
            getline(ss, type, '|');
            getline(ss, sender, '|');
            getline(ss, receiver, '|');

            double amount = stod(amountStr);

            Transaction transaction(accountnum, datetime, amount, type, sender, receiver);

            Account* account = findAccount(accountnum);
            if (account != nullptr) {
                account->addTransaction(transaction);
            }
        }
        inFile.close();
    }
};

bool TransactionAccount::transfer(double amount, string destinationAccountNumber) {
    if (amount < 0 || amount > getcurrentbalance()) {
        return false;
    }

    Account* destination = bank->findAccount(destinationAccountNumber);

    if (destination == nullptr) {
        return false;
    }

    if (!withdraw(amount)) {
        return false;
    }

    if (!destination->deposit(amount)) {
        deposit(amount);

        return false;
    }

    Transaction sentTransaction(
        getaccountnum(),
        getCurrentDateTime(),
        amount,
        "transfer_sent",
        getaccountnum(),
        destinationAccountNumber
    );
    addTransaction(sentTransaction);

    Transaction receivedTransaction(
        destination->getaccountnum(),
        getCurrentDateTime(),
        amount,
        "transfer_received",
        getaccountnum(),
        destinationAccountNumber
    );
    destination->addTransaction(receivedTransaction);

    return true;
}

