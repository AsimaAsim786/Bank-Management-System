void printCentered(const string &text, const string &clr = color::reset) {
    int width = 80;
    int spaces = (width - (int)text.length()) / 2;
    if (spaces < 0) spaces = 0;
    cout << clr;
    for (int i = 0; i < spaces; i++) cout << " ";
    cout << text << color::reset << "\n";
}

